# Gemini API Configurations
GEMINI_API_KEY=your_gemini_api_key_here

# RAG / Vector Database Settings
SIMILARITY_THRESHOLD=0.75
TOP_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHROMA_PERSIST_DIR=./data/chromadb

# Relational Database Storage
SQLITE_DB_PATH=./data/chat_history.db

# API Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://your-vercel-domain.vercel.app"]
LOG_LEVEL=INFO
